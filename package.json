{
  "name": "dsh-agent-scenarios",
  "version": "0.1.0",
  "description": "煤矿领域工具与技能插件；通过 Harness preset 隔离业务能力。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./water-hazard": {
      "types": "./lib/scenarios/water-hazard/index.d.ts",
      "default": "./lib/scenarios/water-hazard/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "skills/**",
    "config/*.patch.yml",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "start": "DSH_HOME=\"$PWD/.dsh\" node --env-file-if-exists=.env ../deepseek-harness/apps/cli/lib/bin.js web --patch \"$PWD/config/openai-compatible.patch.yml\" --no-open",
    "build": "pnpm --filter dsh-agent-charts build && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter dsh-agent-charts build:host && pnpm --filter dsh-agent-charts typecheck && tsc --noEmit && tsc -p tests/browser/tsconfig.json",
    "test": "pnpm --filter dsh-agent-charts test && tsx --test tests/**/*.test.ts",
    "test:browser": "tsx --test tests/browser/*.browser.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx/esm --test tests/integration/*.live.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dependencies": {
    "dsh-agent-charts": "workspace:*"
  },
  "bundledDependencies": [
    "dsh-agent-charts"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-loader": "link:../deepseek-harness/vendor/loader",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-loop": "link:../deepseek-harness/packages/core/agent-loop",
    "@deepseek-ai/dsh-agent-preset": "link:../deepseek-harness/packages/preset/agent-preset",
    "@deepseek-ai/dsh-agent-preset-registry": "link:../deepseek-harness/packages/preset/agent-preset-registry",
    "@deepseek-ai/dsh-fs-local": "link:../deepseek-harness/packages/fs/fs-local",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-llm-pi-ai": "link:../deepseek-harness/packages/llm/llm-pi-ai",
    "@deepseek-ai/dsh-persona": "link:../deepseek-harness/packages/preset/persona",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-projection": "link:../deepseek-harness/packages/session/session-projection",
    "@deepseek-ai/dsh-skill": "link:../deepseek-harness/packages/skill/skill",
    "@deepseek-ai/dsh-skill-filesystem": "link:../deepseek-harness/packages/skill/skill-filesystem",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tool-skill": "link:../deepseek-harness/packages/skill/tool-skill",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-working-directory": "link:../deepseek-harness/packages/session/working-directory",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "yaml": "^2.4.2"
  }
}
