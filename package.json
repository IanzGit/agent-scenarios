{
  "name": "dsh-agent-scenarios",
  "version": "0.1.0",
  "description": "煤矿业务场景工作区与 Harness Bundle。",
  "private": true,
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "config/*.patch.yml",
    "docs/**"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/water-hazard.patch.yml",
        "./presets/hydrology-monitoring.patch.yml",
        "./presets/hydrology-query.patch.yml"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "start": "DSH_HOME=\"$PWD/.dsh\" node --env-file-if-exists=.env ../deepseek-harness/apps/cli/lib/bin.js web --patch \"$PWD/config/openai-compatible.patch.yml\" --no-open",
    "build": "pnpm -r --sort run build",
    "typecheck": "pnpm -r --sort run build:host && pnpm -r --sort run typecheck && tsc --noEmit && tsc -p tests/browser/tsconfig.json",
    "test": "pnpm -r --sort run build:host && pnpm -r --sort run test && tsx --test tests/integration/*.test.ts",
    "test:browser": "tsx --test tests/browser/*.browser.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx/esm --test tests/integration/*.live.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2"
  },
  "dependencies": {
    "dsh-agent-water-hazard": "workspace:*",
    "dsh-agent-hydrology-monitoring": "workspace:*",
    "dsh-agent-charts": "workspace:*",
    "dsh-agent-shared": "workspace:*"
  },
  "bundledDependencies": [
    "dsh-agent-water-hazard",
    "dsh-agent-hydrology-monitoring",
    "dsh-agent-charts",
    "dsh-agent-shared"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-loader": "link:../deepseek-harness/vendor/loader",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-loop": "link:../deepseek-harness/packages/core/agent-loop",
    "@deepseek-ai/dsh-agent-preset": "link:../deepseek-harness/packages/preset/agent-preset",
    "@deepseek-ai/dsh-agent-preset-registry": "link:../deepseek-harness/packages/preset/agent-preset-registry",
    "@deepseek-ai/dsh-fs-local": "link:../deepseek-harness/packages/fs/fs-local",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-llm-pi-ai": "link:../deepseek-harness/packages/llm/llm-pi-ai",
    "@deepseek-ai/dsh-persona": "link:../deepseek-harness/packages/preset/persona",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-projection": "link:../deepseek-harness/packages/session/session-projection",
    "@deepseek-ai/dsh-skill": "link:../deepseek-harness/packages/skill/skill",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tool-skill": "link:../deepseek-harness/packages/skill/tool-skill",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-working-directory": "link:../deepseek-harness/packages/session/working-directory",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "yaml": "^2.4.2",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-chat": "link:../deepseek-harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-home-paths": "link:../deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-session-query": "link:../deepseek-harness/packages/session-query/session-query",
    "@deepseek-ai/dsh-skill-filesystem": "link:../deepseek-harness/packages/skill/skill-filesystem",
    "@deepseek-ai/dsh-subagent": "link:../deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery"
  }
}
